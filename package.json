{
  "name": "vercel-always-on-agent",
  "version": "2.0.0",
  "description": "Vercel Always-On Agent: a personal agent in the style of Muse, OpenClaw, and Dots, built on eve, the AI SDK, the Workflow SDK, AI Gateway, and Vercel Sandbox.",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "dev": "eve dev",
    "build": "eve build",
    "start": "eve start",
    "deploy": "eve deploy",
    "eval": "eve eval",
    "typecheck": "tsc",
    "test": "tsx --test test/*.test.ts",
    "telegram:poll": "node scripts/telegram-poll.ts",
    "telegram:webhook": "node scripts/telegram-webhook.ts",
    "local:start": "scripts/keychain-run.sh npm start",
    "local:telegram": "scripts/keychain-run.sh npm run telegram:poll",
    "local:dev": "scripts/keychain-run.sh npm run dev"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.95",
    "@ai-sdk/harness": "^1.0.150",
    "@ai-sdk/harness-claude-code": "^1.0.154",
    "@ai-sdk/openai-compatible": "^3.0.68",
    "@ai-sdk/sandbox-vercel": "^1.0.150",
    "@vercel/connect": "2.2.0",
    "ai": "^7.0.137",
    "croner": "^10.0.1",
    "eve": "^0.79.0",
    "just-bash": "^3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
