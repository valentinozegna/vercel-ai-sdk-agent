{
  "name": "vercel-ai-sdk-agent",
  "version": "2.0.0",
  "description": "An always-on personal agent (Muse / OpenClaw / Dots style) built on Vercel's eve framework, AI SDK, Workflow SDK, and AI Gateway.",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "dev": "eve dev",
    "build": "eve build",
    "start": "eve start",
    "deploy": "eve deploy",
    "eval": "eve eval",
    "typecheck": "tsc",
    "test": "tsx --test test/*.test.ts",
    "telegram:poll": "node scripts/telegram-poll.ts",
    "telegram:webhook": "node scripts/telegram-webhook.ts"
  },
  "dependencies": {
    "@vercel/connect": "2.2.0",
    "ai": "^7.0.137",
    "croner": "^10.0.1",
    "eve": "^0.79.0",
    "just-bash": "^3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
