# Copy to .env and fill in your own key. Never commit .env.
#
# Vercel AI Gateway key: https://vercel.com/docs/ai-gateway
# Plain "provider/model" IDs are resolved through the gateway.
AI_GATEWAY_API_KEY=

# Any model ID the gateway supports, for example:
#   anthropic/claude-sonnet-5.5
#   openai/gpt-5
#   google/gemini-3-pro
#   xai/grok-4
AI_MODEL=anthropic/claude-sonnet-5.5
