# Copy to .env and fill in. Never commit .env.

# --- Model access -----------------------------------------------------------
# Vercel AI Gateway key: https://vercel.com/docs/ai-gateway
# The model is set in agent/agent.ts (change it with `npx eve set model <id>`).
AI_GATEWAY_API_KEY=

# --- Owner ------------------------------------------------------------------
# Your IANA time zone. Routines, the heartbeat, and the clock use it.
OWNER_TIMEZONE=Europe/Rome
# Optional: how the agent should address you.
OWNER_NAME=

# --- Telegram (main channel) ------------------------------------------------
# Create a bot with @BotFather and paste its token.
TELEGRAM_BOT_TOKEN=
# Without @. Optional for private chats.
TELEGRAM_BOT_USERNAME=
# Any random string (openssl rand -hex 32). The webhook route rejects updates without it.
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# Your numeric Telegram user ID (ask @userinfobot). Comma-separate several.
# Everyone else is ignored.
TELEGRAM_OWNER_IDS=
# Chat for proactive messages. Defaults to the first owner ID (your DM with the bot).
TELEGRAM_OWNER_CHAT_ID=

# --- HTTP API ---------------------------------------------------------------
# Basic auth for the /eve/v1 session API (TUI, curl, web clients).
# Without a password, only `eve dev` on localhost can use it.
EVE_ADMIN_USER=owner
EVE_ADMIN_PASSWORD=

# --- Proactivity ------------------------------------------------------------
# Minutes between heartbeats (0 turns the heartbeat off). The heartbeat only
# calls the model when its checklist has something on it.
HEARTBEAT_INTERVAL_MINUTES=30
# No heartbeats in this window, owner's local time, 24h "start-end".
QUIET_HOURS=23-7

# --- Runtime ----------------------------------------------------------------
# Where memory, routines, the heartbeat checklist, and the activity log live.
AGENT_DATA_DIR=.data
# Sandbox for bash/read_file/write_file, chosen at build time:
#   just-bash (default, no dependencies), docker (real Linux, needs Docker), vercel
AGENT_SANDBOX=just-bash
# Used by the Telegram polling bridge to reach the agent.
AGENT_URL=http://127.0.0.1:3000
