# Copy to .env and fill in. Never commit .env.

# --- Model (the agent's brain) ----------------------------------------------
# Set ONE credential. Without AGENT_MODEL, the first one present is used, in
# this order, with that provider's default model.
#
# Vercel AI Gateway: any model from any provider with one key.
AI_GATEWAY_API_KEY=
# Anthropic API. Claude Max and Team plans include monthly API credits:
# claim them on claude.ai > Settings > Billing, then create a key in that
# Console organization.
ANTHROPIC_API_KEY=
# OpenAI API.
OPENAI_API_KEY=
# Google Gemini API (GOOGLE_GENERATIVE_AI_API_KEY also works).
GEMINI_API_KEY=
# Local OpenAI-compatible server, e.g. Ollama: http://127.0.0.1:11434/v1
LOCAL_MODEL_BASE_URL=

# Optional explicit choice, "<provider>:<model>" or a bare Gateway ID:
#   anthropic/claude-opus-5.5     (Gateway)
#   anthropic:claude-opus-5-5     openai:gpt-6-luna     google:gemini-4-argon
#   chatgpt:gpt-6-luna-fast       (ChatGPT subscription, local `eve dev` only)
#   local:llama3.3
AGENT_MODEL=
# Model for the researcher subagent. Defaults to a lighter model of the same provider.
RESEARCHER_MODEL=
# Context window for local or unlisted models, in tokens.
AGENT_CONTEXT_WINDOW=

# --- Claude Code (delegate for hands-on jobs) -------------------------------
# The claude_code tool runs Claude Code in a Vercel Sandbox.
#   subscription (default): your Claude plan
#   api-key: ANTHROPIC_API_KEY      gateway: AI_GATEWAY_API_KEY
CLAUDE_CODE_AUTH=subscription
# Subscription on a server: run `claude setup-token` and paste the token.
# On a Mac where you are logged in to Claude Code, leave it empty.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional Claude Code model, e.g. claude-opus-5-5. Empty uses Claude Code's default.
CLAUDE_CODE_MODEL=
# Vercel Sandbox access. Either VERCEL_OIDC_TOKEN (vercel link && vercel env pull)
# or an access token with team and project IDs:
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# --- Owner ------------------------------------------------------------------
# Your IANA time zone. Routines, the heartbeat, and the clock use it.
OWNER_TIMEZONE=Europe/Rome
# Optional: how the agent should address you.
OWNER_NAME=

# --- Telegram (main channel) ------------------------------------------------
# Create a bot with @BotFather and paste its token.
TELEGRAM_BOT_TOKEN=
# Without @. Optional for private chats.
TELEGRAM_BOT_USERNAME=
# Any random string (openssl rand -hex 32). The webhook route rejects updates without it.
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# Your numeric Telegram user ID (ask @userinfobot). Comma-separate several.
# Everyone else is ignored.
TELEGRAM_OWNER_IDS=
# Chat for proactive messages. Defaults to the first owner ID (your DM with the bot).
TELEGRAM_OWNER_CHAT_ID=

# --- HTTP API ---------------------------------------------------------------
# Basic auth for the /eve/v1 session API (TUI, curl, web clients).
# Without a password, only `eve dev` on localhost can use it.
EVE_ADMIN_USER=owner
EVE_ADMIN_PASSWORD=

# --- Proactivity ------------------------------------------------------------
# Minutes between heartbeats (0 turns the heartbeat off). The heartbeat only
# calls the model when its checklist has something on it.
HEARTBEAT_INTERVAL_MINUTES=30
# No heartbeats in this window, owner's local time, 24h "start-end".
QUIET_HOURS=23-7

# --- Secrets from the macOS keychain (local use) ----------------------------
# scripts/keychain-run.sh (used by `npm run local:*`) loads these from keychain
# items with the same service name, so the values never sit in this file.
# Leave the variables themselves empty above. Store one with:
#   security add-generic-password -a "$USER" -s TELEGRAM_BOT_TOKEN -w
KEYCHAIN_SECRETS=

# --- Runtime ----------------------------------------------------------------
# Where memory, routines, the heartbeat checklist, and the activity log live.
AGENT_DATA_DIR=.data
# Sandbox for bash/read_file/write_file, chosen at build time:
#   just-bash (default, no dependencies), docker (real Linux, needs Docker), vercel
AGENT_SANDBOX=just-bash
# Used by the Telegram polling bridge to reach the agent.
AGENT_URL=http://127.0.0.1:3000
